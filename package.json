{
  "name": "personal-agent-workspace",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "sdk"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run typecheck && npm run build -w frontend",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "sdk:generate": "make gen",
    "lint": "eslint && prettier --check .",
    "fmt": "prettier --write . && eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
